<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DevCrew.Desktop.ViewModels"
             xmlns:behaviors="using:DevCrew.Desktop.Behaviors"
             x:Class="DevCrew.Desktop.Views.McpView"
             x:DataType="vm:McpViewModel"
             behaviors:LoadedCommandBehavior.Command="{Binding InitializeCommand}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Border Padding="{DynamicResource ResponsivePaddingMedium}"
                Background="{StaticResource BrushSecondaryBackground}">
            <StackPanel Spacing="20"
                        MaxWidth="960"
                        HorizontalAlignment="Center">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{DynamicResource FontSizeHeading}"
                               FontFamily="{DynamicResource FontHeading}"
                               FontWeight="Bold"
                               Foreground="{StaticResource BrushPrimaryText}" />
                    <TextBlock Text="{Binding Description}"
                               Foreground="{StaticResource BrushSecondaryText}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border BorderBrush="{StaticResource BrushBorderSecondary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{StaticResource BrushTertiaryBackground}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding ExecutableStatusLabel}"
                                   FontSize="{DynamicResource FontSizeLabel}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushPrimaryText}" />
                        <TextBlock Text="{Binding ExecutableStatus}"
                                   FontFamily="{DynamicResource FontDefault}"
                                   Foreground="{StaticResource BrushSecondaryText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource BrushBorderSecondary}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Background="{StaticResource BrushTertiaryBackground}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="{Binding ClientLabel}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushPrimaryText}" />
                                <ComboBox ItemsSource="{Binding Clients}"
                                          SelectedItem="{Binding SelectedClient, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="8">
                                <TextBlock Text="{Binding TransportLabel}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushPrimaryText}" />
                                <Border Background="{StaticResource BrushSecondaryBackground}"
                                        BorderBrush="{StaticResource BrushBorderSecondary}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        MinHeight="36">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="ℹ"
                                                   Foreground="{StaticResource BrushSecondaryText}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TransportValue}"
                                                   Foreground="{StaticResource BrushSecondaryText}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding ConfigurationLabel}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushPrimaryText}" />
                        <TextBox Text="{Binding ConfigurationText}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 MinHeight="220"
                                 FontFamily="{DynamicResource FontDefault}"
                                 VerticalContentAlignment="Top"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="{Binding CopyConfigurationButtonLabel}"
                                    Command="{Binding CopyConfigurationCommand}"
                                    Classes="PrimaryActionButton" />
                            <Button Content="{Binding AddToVsCodeButtonLabel}"
                                    Command="{Binding AddToVsCodeCommand}"
                                    Classes="PrimaryActionButton" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource BrushSecondaryText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
